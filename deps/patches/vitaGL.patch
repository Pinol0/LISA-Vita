diff --git a/Makefile b/Makefile
index fabb381..5f1f84b 100644
--- a/Makefile
+++ b/Makefile
@@ -148,6 +148,24 @@ ifeq ($(LOG_ERRORS),1)
 CFLAGS += -DLOG_ERRORS
 endif
 
+# mkxp Vita: VITA_RT_TEXTURE_TRACKING (render-target textures tracked by the GC) + VGL_APP_LOG
+# (vgl_log -> vgl_app_log() of the application; use with LOG_ERRORS=1).
+ifeq ($(MKXP_DIAG),1)
+CFLAGS += -DVGL_APP_LOG
+endif
+
+# NOT enabled by MKXP_DIAG: tracking render-target textures makes a glTexSubImage2D into a texture
+# that is the active render target in the same frame copy-on-write it away from its FBO (mkxp's
+# TileAtlasVX shadow upload -> empty tilesets, seen on hardware with build d16).
+# mkxp Vita: FBOs without a depth/stencil renderbuffer get no depth surface (see gxm.c).
+ifeq ($(MKXP_NO_FBO_DEPTH),1)
+CFLAGS += -DMKXP_NO_FBO_DEPTH
+endif
+
+ifeq ($(MKXP_RT_TRACK),1)
+CFLAGS += -DVITA_RT_TEXTURE_TRACKING
+endif
+
 ifeq ($(HAVE_PROFILING),1)
 CFLAGS += -DHAVE_PROFILING
 endif
