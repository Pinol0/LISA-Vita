@@ -233,7 +237,11 @@ void *gpu_alloc_mapped_aligned_for_cpu(size_t alignment, size_t size) {
 	return res;
 }
 
+#ifdef VGL_APP_LOG
+static void *gpu_alloc_mapped_aligned_for_gpu_impl(size_t alignment, size_t size) {
+#else
 void *gpu_alloc_mapped_aligned_for_gpu(size_t alignment, size_t size) {
+#endif
 	void *res = gpu_alloc_mapped_aligned_for_gpu_inner(alignment, size);
 	if (res)
 		return res;
@@ -1008,3 +1016,30 @@ void gpu_alloc_planar_texture(uint32_t w, uint32_t h, SceGxmTextureFormat format
 #endif
 	}
 }
+
+#ifdef VGL_APP_LOG
+/* mkxp Vita diagnostic: every allocation >= 4 MiB is counted and logged (size, pool, caller) so the
+ * application can attribute it to the GL call that triggered it (vgl_diag_bigalloc_count). */
+volatile unsigned int vgl_diag_bigalloc_count = 0;
+volatile unsigned int vgl_diag_bigalloc_last_size = 0;
+uint32_t vgl_diag_circular_peak = 0;
+static void vgl_diag_bigalloc(const char *kind, size_t size, void *res, void *ra) {
+	if (size < 4 * 1024 * 1024)
+		return;
+	vgl_diag_bigalloc_count++;
+	vgl_diag_bigalloc_last_size = size;
+	vgl_log("BIGALLOC %s size=%u pool=%d res=%p vgl_ra=%p free_vram=%u free_ram=%u free_phycont=%u\n", kind, size,
+	        res ? (int)vgl_mem_get_type_by_addr(res) : -1, res, ra, vglMemFree(VGL_MEM_VRAM), vglMemFree(VGL_MEM_RAM),
+	        vglMemFree(VGL_MEM_PHYCONT));
+}
+void *gpu_alloc_mapped_aligned_for_gpu(size_t alignment, size_t size) {
+	void *res = gpu_alloc_mapped_aligned_for_gpu_impl(alignment, size);
+	vgl_diag_bigalloc("for_gpu", size, res, __builtin_return_address(0));
+	return res;
+}
+void *gpu_alloc_mapped_aligned_for_cpu(size_t alignment, size_t size) {
+	void *res = gpu_alloc_mapped_aligned_for_cpu_impl(alignment, size);
+	vgl_diag_bigalloc("for_cpu", size, res, __builtin_return_address(0));
+	return res;
+}
+#endif
