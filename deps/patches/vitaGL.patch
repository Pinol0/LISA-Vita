index 4464db5..87da393 100644
--- a/source/utils/gpu_utils.c
+++ b/source/utils/gpu_utils.c
@@ -204,7 +204,11 @@ void *gpu_alloc_mapped_aligned_unsafe_for_gpu(size_t alignment, size_t size) {
 	return res;
 }
 
+#ifdef VGL_APP_LOG
+static void *gpu_alloc_mapped_aligned_for_cpu_impl(size_t alignment, size_t size) {
