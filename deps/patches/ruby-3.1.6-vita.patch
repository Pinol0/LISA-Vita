--- ruby-3.1.6.orig/coroutine/pthread/Context.c	2026-10-06 21:41:20.590642575 +0200
+++ ruby-3.1.6/coroutine/pthread/Context.c	2026-10-06 21:41:20.605727289 +0200
@@ -9,9 +9,71 @@
 #include <stdlib.h>
 #include <stdio.h>
 #include <errno.h>
+#ifdef COROUTINE_VITA
+#include <setjmp.h>
+#endif
 
 static const int DEBUG = 0;
 
+#ifdef COROUTINE_VITA
+// Only the thread currently running Ruby (or a thread holding shared->guard) updates these.
+static struct coroutine_vita_stats coroutine_vita_stats;
+
+void coroutine_vita_get_stats(struct coroutine_vita_stats * stats)
+{
+    *stats = coroutine_vita_stats;
+}
+
+/*
+ * Thread pool (libruby v8). Every Ruby Fiber runs on a thread of its own here, and on the Vita
+ * starting a thread costs ~750 us and joining a finished one ~400 us (mkxp d75 profiler); LISA's
+ * parallel common events start up to one Fiber per frame. A thread whose coroutine is over (it left
+ * through coroutine_transfer_exit(), or it was destroyed while suspended) does not exit: it jumps
+ * back to its loop (longjmp, discarding the finished coroutine's frames as pthread_exit() did) and
+ * waits for the next coroutine. Nothing changes for Ruby: Fibers are created and freed as before.
+ * The Vita path uses no pthread cleanup handlers (they would be left dangling by the longjmp): the
+ * unlock and the release they did are done explicitly before jumping.
+ */
+struct coroutine_worker
+{
+    pthread_t id;
+    pthread_cond_t wake;                            // the worker waits here for a coroutine
+    struct coroutine_context * volatile context;    // assigned coroutine (pool_mutex), NULL = idle
+    jmp_buf exit;                                   // back to the loop when the coroutine is over
+    struct coroutine_worker * next;                 // idle list
+};
+
+static pthread_mutex_t pool_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t pool_released = PTHREAD_COND_INITIALIZER;   // a destroyed coroutine was released
+static struct coroutine_worker * pool_idle = NULL;
+static unsigned int pool_idle_count = 0, pool_spawned = 0, pool_reused = 0;
+enum { POOL_MAX_IDLE = 4 };   // idle threads kept (each holds its kernel stack)
+
+#ifndef __vita__
+// Host test only (the Vita has no fork): a forked child has none of the pool threads; forget them,
+// and coroutines whose thread was the parent's are released without waiting for that thread
+// (upstream: pthread_cancel -> ESRCH, "the thread may be dead due to fork").
+static unsigned int pool_generation = 0;
+static void coroutine_pool_atfork_child(void)
+{
+    pthread_mutex_init(&pool_mutex, NULL);
+    pthread_cond_init(&pool_released, NULL);
+    pool_idle = NULL;
+    pool_idle_count = 0;
+    pool_generation += 1;
+}
+#endif
+
+void coroutine_vita_pool_stats(unsigned int * spawned, unsigned int * reused, unsigned int * idle)
+{
+    pthread_mutex_lock(&pool_mutex);
+    *spawned = pool_spawned;
+    *reused = pool_reused;
+    *idle = pool_idle_count;
+    pthread_mutex_unlock(&pool_mutex);
+}
+#endif
+
