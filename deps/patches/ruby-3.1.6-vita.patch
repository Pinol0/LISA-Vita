+        // (it touches nothing of the coroutine after the signal), so the coroutine is reaped at once.
+        // Nothing can wait on or signal an exited coroutine's schedule any more: destroy it now.
+        // Each pthread-embedded cond holds kernel semaphores; keeping them until GC runs the
+        // process out of semaphores (pthread_cond_init -> sem_init -> ENOSPC).
+        struct coroutine_context * waker = current->from;
