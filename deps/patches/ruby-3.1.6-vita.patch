+
+// The pool thread's loop. Named coroutine_trampoline as the upstream start routine: mkxp's
+// MKXP_VITA_FIBER_CORE0 recognises a Fiber thread by this start routine.
+void * coroutine_trampoline(void * _worker)
+{
+    struct coroutine_worker * const worker = _worker;
+
+    for (;;) {
+        struct coroutine_context * context;
+
+        pthread_mutex_lock(&pool_mutex);
+        while (!(context = worker->context))
+            pthread_cond_wait(&worker->wake, &pool_mutex);
+        pthread_mutex_unlock(&pool_mutex);
+
+        if (setjmp(worker->exit) == 0)
+            coroutine_run(context);
+
+        // The coroutine is over: nothing of it is touched from here on.
+        pthread_mutex_lock(&pool_mutex);
+        worker->context = NULL;
+        if (pool_idle_count < POOL_MAX_IDLE) {
+            worker->next = pool_idle;
+            pool_idle = worker;
+            pool_idle_count += 1;
+            pthread_mutex_unlock(&pool_mutex);
+            continue;
+        }
+        pthread_mutex_unlock(&pool_mutex);
+
+        // Enough idle threads: this one ends (nobody joins pool threads).
+        pthread_cond_destroy(&worker->wake);
+        pthread_detach(worker->id);
+        free(worker);
+        return NULL;
+    }
+}
+
+// Called with current->shared->guard held, target->shared already set.
+static
+int coroutine_create_thread(struct coroutine_context *context)
+{
+    int result = pthread_cond_init(&context->schedule, NULL);
+    if (result != 0) {
+        return result;
+    }
+
+    struct coroutine_worker * worker = NULL;
+
+    pthread_mutex_lock(&pool_mutex);
+    if (pool_idle) {
+        worker = pool_idle;
+        pool_idle = worker->next;
+        pool_idle_count -= 1;
+        context->worker = worker;
+        context->id = worker->id;
+        worker->context = context;
+        pool_reused += 1;
+        pthread_cond_signal(&worker->wake);
+    }
+    pthread_mutex_unlock(&pool_mutex);
+
+    if (!worker) {
+        worker = (struct coroutine_worker *)malloc(sizeof(struct coroutine_worker));
+        if (!worker) {
+            pthread_cond_destroy(&context->schedule);
+            return ENOMEM;
+        }
+        result = pthread_cond_init(&worker->wake, NULL);
+        if (result != 0) {
+            free(worker);
+            pthread_cond_destroy(&context->schedule);
+            return result;
+        }
+        worker->context = context;
+        worker->next = NULL;
+        context->worker = worker;
+
+        // The thread's own stack, of the coroutine's size: a pool thread outlives the coroutine it
+        // was created for, so it cannot run on that coroutine's stack (the Vita ignored that address
+        // anyway: cont.c fiber_entry takes the stack bounds from the thread).
+        pthread_attr_t attr;
+        result = pthread_attr_init(&attr);
+        if (result == 0) {
+            result = pthread_attr_setstacksize(&attr, (size_t)context->size);
+            if (result == 0)
+                result = pthread_create(&worker->id, &attr, coroutine_trampoline, worker);
+            pthread_attr_destroy(&attr);   // pthread-embedded's attr is a malloc'd block (v7 fix)
+        }
+        if (result != 0) {
+            context->worker = NULL;
+            pthread_cond_destroy(&worker->wake);
+            free(worker);
+            pthread_cond_destroy(&context->schedule);
+            return result;
+        }
+        context->id = worker->id;
+
+        pthread_mutex_lock(&pool_mutex);
+        pool_spawned += 1;
+        pthread_mutex_unlock(&pool_mutex);
+    }
