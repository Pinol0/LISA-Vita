+    if (target->shared == NULL) {
+        target->shared = current->shared;
+
+        int create_error = coroutine_create_thread(target);
+        if (create_error) {
+            target->shared = NULL;
+            target->from = previous;
+            pthread_mutex_unlock(&current->shared->guard);
+            // pthread_create() reports its error as a return value, not in errno.
+            errno = create_error;
+            return NULL;
+        }
+    } else {
+        pthread_cond_signal(&target->schedule);
+    }
+
