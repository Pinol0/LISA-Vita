+    // it as the cleanup handlers did (guard unlock, then coroutine_release) and give the thread back.
+    if (current->from == current) {
+        struct coroutine_worker * worker = current->worker;
+        pthread_mutex_unlock(&current->shared->guard);
+        coroutine_release(current);
+        coroutine_mark_released(current);   // current may be freed from here on
+        longjmp(worker->exit, 1);
+    }
