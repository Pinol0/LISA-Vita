+static uint32_t vitaTmTableFnv(const Table &t)
+{
+	uint32_t h = 0x811C9DC5u;
+	for (int z = 0; z < t.zSize(); ++z)
+		for (int y = 0; y < t.ySize(); ++y)
+			for (int x = 0; x < t.xSize(); ++x)
+			{
+				uint16_t v = (uint16_t)t.get(x, y, z);
+				h = (h ^ (v & 0xFF)) * 0x01000193u;
+				h = (h ^ (v >> 8)) * 0x01000193u;
+			}
+	return h;
+}
