diff --git a/src/vita_diag.h b/src/vita_diag.h
new file mode 100644
--- /dev/null
+++ b/src/vita_diag.h
@@ -0,0 +1,96 @@
+/*
+ * Vita-only diagnostics shared by several subsystems (OFF by default, no code when OFF):
+ *
+ *   MKXP_VITA_TIMELINE     one-shot timeline with absolute timestamps for the first boot and for
+ *                          each battle entry (boot_timeline.log / battle_timeline.log);
+ *   MKXP_VITA_PERF_BITMAP  per-120-frame counters (count / time / bytes) appended to the PERF lines.
+ *
+ * Both are fed by the same VITA_DIAG_* calls. Storage and output live in
+ * src/vita_diag.cpp of the Vita port.
+ */
+#ifndef VITA_DIAG_H
+#define VITA_DIAG_H
+
+#if defined(MKXP_VITA_TIMELINE) || defined(MKXP_VITA_PERF_BITMAP)
+#define MKXP_VITA_DIAG 1
+
+#include <stdint.h>
+
+enum VitaDiagOp
+{
+    VD_SCRIPT_EVAL,      /* main.cpp: one Scripts.rvdata2 entry */
+    VD_SHADERSET,        /* SharedState::shaders(): first ShaderSet construction */
+    VD_GL_COMPILE,       /* glCompileShader (gl function table) */
+    VD_GL_LINK,          /* glLinkProgram */
+    VD_GL_TEXIMAGE,      /* glTexImage2D (bytes = w*h*4) */
+    VD_GL_TEXSUBIMAGE,   /* glTexSubImage2D */
+    VD_ATLAS_BUILD,      /* TileAtlasVX::build */
+    VD_PNG_DECODE,       /* Bitmap(filename) PNG decode + texture */
+    VD_BMP_UPLOAD,       /* Bitmap CPU copy -> full texture upload (bytes) */
+    VD_STRETCH_BLT,
+    VD_RADIAL_BLUR,
+    VD_FILL_RECT,
+    VD_GRADIENT,
+    VD_CLEAR,
+    VD_CLEAR_RECT,
+    VD_BLT,
+    VD_DRAW_TEXT,        /* whole Bitmap#draw_text (TTF path) */
+    VD_TEXT_SIZE,
+    VD_TTF_INIT,
+    VD_TTF_OPEN,         /* TTF_OpenFont (cache miss) */
+    VD_TTF_RENDER,       /* TTF_RenderUTF8_Blended (text + outline surfaces) */
+    VD_FONT_HIT,         /* font cache hit (count only) */
+    VD_FRAME_PREPARE,
+    VD_FRAME_COMPOSITE,
+    VD_FRAME_SWAP,
+    VD_WIN_REFRESH,      /* Ruby: Window_Base subclasses #refresh (outermost call only) */
+    VD_WIN_BASE_REDRAW,  /* WindowVX::redrawBaseTex (one FBO scene each) */
+    VD_OP_COUNT
+};
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+uint64_t vitaDiagNow(void);
+/* dt = now - t0; bytes optional; detail is copied (timeline only). */
+void vitaDiagSpan(int op, uint64_t t0, uint64_t bytes, const char *detail);
+void vitaDiagCount(int op);
+/* Timeline events with free-form tags (Ruby hooks, milestones). */
+void vitaDiagMark(const char *tag, const char *detail);
+void vitaDiagNamedSpan(const char *tag, uint64_t t0, const char *detail);
+/* Called once per presented frame (end of vitaRenderFrame), from the main thread. */
+void vitaDiagFrameDone(void);
+#ifdef __cplusplus
+}
+#endif
+
+#define VITA_DIAG_T0(var) const uint64_t var = vitaDiagNow()
+#define VITA_DIAG_SPAN(op, t0, bytes, detail) vitaDiagSpan((op), (t0), (bytes), (detail))
+#define VITA_DIAG_COUNT(op) vitaDiagCount(op)
+#define VITA_DIAG_MARK(tag, detail) vitaDiagMark((tag), (detail))
+
+#ifdef __cplusplus
+/* Times the outermost Bitmap operation only (clear_rect -> fill_rect, blt -> stretch_blt, ...). */
+extern int vitaDiagOpDepth;
+struct VitaDiagOpScope
+{
+    int op;
+    uint64_t t0;
+    bool outer;
+    explicit VitaDiagOpScope(int o) : op(o), t0(vitaDiagNow()), outer(vitaDiagOpDepth++ == 0) {}
+    ~VitaDiagOpScope() { --vitaDiagOpDepth; if (outer) vitaDiagSpan(op, t0, 0, nullptr); }
+};
+#define VITA_DIAG_OP(op) VitaDiagOpScope vitaDiagOpScope_(op)
+#endif
+
+#else
+
+#define VITA_DIAG_T0(var)
+#define VITA_DIAG_SPAN(op, t0, bytes, detail)
+#define VITA_DIAG_COUNT(op)
+#define VITA_DIAG_MARK(tag, detail)
+#define VITA_DIAG_OP(op)
+
+#endif
+
+#endif /* VITA_DIAG_H */
