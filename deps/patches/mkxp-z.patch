+static void vitaTmLogBounds(const char *tag, const std::vector<SVertex> &v)
+{
+	if (v.empty())
+	{
+		vitaTmLog("TILEMAP_BOUNDS %s vertices=0", tag);
+		return;
+	}
+	float px0 = v[0].pos.x, px1 = px0, py0 = v[0].pos.y, py1 = py0;
+	float tx0 = v[0].texPos.x, tx1 = tx0, ty0 = v[0].texPos.y, ty1 = ty0;
+	for (size_t i = 1; i < v.size(); ++i)
+	{
+		const SVertex &s = v[i];
+		px0 = std::min(px0, s.pos.x);
+		px1 = std::max(px1, s.pos.x);
+		py0 = std::min(py0, s.pos.y);
+		py1 = std::max(py1, s.pos.y);
+		tx0 = std::min(tx0, s.texPos.x);
+		tx1 = std::max(tx1, s.texPos.x);
+		ty0 = std::min(ty0, s.texPos.y);
+		ty1 = std::max(ty1, s.texPos.y);
+	}
+	vitaTmLog("TILEMAP_BOUNDS %s vertices=%u pos_x=%.2f..%.2f pos_y=%.2f..%.2f tex_x=%.2f..%.2f tex_y=%.2f..%.2f",
