+/* Reads the bound framebuffer (glFinish + glReadPixels) and saves it; also compares with the
+ * memory of its colour attachment texture. Restores the texture binding it touches. */
+static void vitaTmDumpScene(const char *file)
+{
+	GLint fbo = 0, att = 0, prevTex = 0;
+	gl.GetIntegerv(GL_FRAMEBUFFER_BINDING, &fbo);
+	glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &att);
+	gl.GetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+
+	int w = 544, h = 416;
+	const uint8_t *texmem = NULL;
+	if (att)
+	{
+		gl.BindTexture(GL_TEXTURE_2D, (GLuint)att);
+		SceGxmTexture *gt = vglGetGxmTexture(GL_TEXTURE_2D);
+		if (gt)
+		{
+			w = (int)sceGxmTextureGetWidth(gt);
+			h = (int)sceGxmTextureGetHeight(gt);
+		}
+		texmem = (const uint8_t *)vglGetTexDataPointer(GL_TEXTURE_2D);
+		gl.BindTexture(GL_TEXTURE_2D, (GLuint)prevTex);
+	}
+
+	glFinish();
+	uint8_t *buf = (uint8_t *)malloc((size_t)w * h * 4);
+	int rc = -3;
+	int diffRows = -1;
+	if (buf)
+	{
+		memset(buf, 0, (size_t)w * h * 4);
+		gl.ReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, buf);
+		GLenum e = gl.GetError();
+		char name[160];
+		snprintf(name, sizeof(name), VITA_TM_DIR "%s", file);
+		rc = vitaTmWriteTga(name, buf, w, h, w * 4);
+		if (texmem)
+		{
+			const int stride = ((w + 7) & ~7) * 4;
+			diffRows = 0;
+			for (int y = 0; y < h; ++y)
+				if (memcmp(buf + (size_t)y * w * 4, texmem + (size_t)y * stride, (size_t)w * 4) != 0)
+					++diffRows;
+		}
+		vitaTmLog("TILEMAP_DUMP file=%s framebuffer=0x%x color_attachment_tex=%d size=%dx%d readpixels_err=0x%x "
+		          "READPIXELS_VS_TEXMEM differing_rows=%d rc=%d",
+		          file, (unsigned)fbo, att, w, h, (unsigned)e, diffRows, rc);
+		free(buf);
+	}
+	else
+		vitaTmLog("TILEMAP_DUMP file=%s malloc failed", file);
+}
