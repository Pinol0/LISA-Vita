+/* Uncompressed 32-bit TGA, top-left origin: file row 0 = memory row 0. */
+static int vitaTmWriteTga(const char *name, const uint8_t *rgba, int w, int h, int strideBytes)
+{
+	if (!rgba)
+		return -3;
+	FILE *f = fopen(name, "wb");
+	if (!f)
+		return -1;
+	uint8_t hdr[18];
+	memset(hdr, 0, sizeof(hdr));
+	hdr[2] = 2;
+	hdr[12] = w & 0xff; hdr[13] = (w >> 8) & 0xff;
+	hdr[14] = h & 0xff; hdr[15] = (h >> 8) & 0xff;
+	hdr[16] = 32;
+	hdr[17] = 0x28;
+	int rc = fwrite(hdr, 1, sizeof(hdr), f) == sizeof(hdr) ? 0 : -2;
+	std::vector<uint8_t> row(w * 4);
+	for (int y = 0; y < h && rc == 0; ++y)
+	{
+		const uint8_t *src = rgba + (size_t)y * strideBytes;
+		for (int x = 0; x < w; ++x)
+		{
+			row[x*4+0] = src[x*4+2];
+			row[x*4+1] = src[x*4+1];
+			row[x*4+2] = src[x*4+0];
+			row[x*4+3] = src[x*4+3];
+		}
+		if (fwrite(row.data(), 1, row.size(), f) != row.size())
+			rc = -2;
+	}
+	fclose(f);
+	return rc;
+}
