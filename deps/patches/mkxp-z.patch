diff --git a/src/vita_perf.h b/src/vita_perf.h
new file mode 100644
--- /dev/null
+++ b/src/vita_perf.h
@@ -0,0 +1,69 @@
+/*
+ * Vita-only lightweight profiler hooks (MKXP_VITA_PERF_PROFILE, OFF by default).
+ *
+ * Subsystem timers are inclusive of everything they call; counters count calls made through
+ * mkxp's GL function table (not vitaGL-internal calls). The storage and the 120-frame summary
+ * live in src/shell/sharedstate-vita.cpp. Without the define every macro expands to nothing.
+ */
+#ifndef VITA_PERF_H
+#define VITA_PERF_H
+
+#ifdef MKXP_VITA_PERF_PROFILE
+
+#include <psp2/kernel/processmgr.h>
+
+enum VitaPerfSub
+{
+	VITA_PERF_SUB_TILEMAP_PREPARE,  /* TilemapVXPrivate::prepare(), incl. rebuilds below */
+	VITA_PERF_SUB_TILEMAP_REBUILD,  /* TilemapVXPrivate::rebuildBuffers(), incl. VBO upload */
+	VITA_PERF_SUB_ATLAS_REBUILD,    /* TilemapVXPrivate::rebuildAtlas() */
+	VITA_PERF_SUB_SPRITE_PREPARE,   /* SpritePrivate::prepare() */
+	VITA_PERF_SUB_WINDOW_PREPARE,   /* WindowVXPrivate::prepare() */
+	VITA_PERF_SUB_TILEMAP_DRAW,     /* TilemapVXPrivate::drawGround() + drawAbove() */
+	VITA_PERF_SUB_SPRITE_DRAW,      /* Sprite::draw() */
+	VITA_PERF_SUB_WINDOW_DRAW,      /* WindowVX::draw() */
+	VITA_PERF_SUB_COUNT
+};
+
+enum VitaPerfCounter
+{
+	VITA_PERF_CNT_DRAW_ELEMENTS,
+	VITA_PERF_CNT_BLIT_FRAMEBUFFER,
+	VITA_PERF_CNT_TEXTURE_BINDS,
+	VITA_PERF_CNT_PROGRAM_BINDS,
+	VITA_PERF_CNT_FBO_BINDS,
+	VITA_PERF_CNT_BUFFER_DATA,
+	VITA_PERF_CNT_BUFFER_SUBDATA,
+	VITA_PERF_CNT_TEX_IMAGE,
+	VITA_PERF_CNT_TEX_SUBIMAGE,
+	VITA_PERF_CNT_TILEMAP_REBUILDS,
+	VITA_PERF_CNT_ATLAS_REBUILDS,
+	VITA_PERF_CNT_TILEMAP_DRAWS,
+	VITA_PERF_CNT_SPRITE_DRAWS,
+	VITA_PERF_CNT_WINDOW_DRAWS,
+	VITA_PERF_CNT_COUNT
+};
+
+extern SceUInt64 vitaPerfSubUs[VITA_PERF_SUB_COUNT];
+extern unsigned int vitaPerfCounters[VITA_PERF_CNT_COUNT];
+
+struct VitaPerfScope
+{
+	int sub;
+	SceUInt64 t0;
+
+	explicit VitaPerfScope(int s) : sub(s), t0(sceKernelGetProcessTimeWide()) {}
+	~VitaPerfScope() { vitaPerfSubUs[sub] += sceKernelGetProcessTimeWide() - t0; }
+};
+
+#define VITA_PERF_SCOPE(sub) VitaPerfScope vitaPerfScope(VITA_PERF_SUB_##sub)
+#define VITA_PERF_COUNT(cnt) (++vitaPerfCounters[VITA_PERF_CNT_##cnt])
+
+#else
+
+#define VITA_PERF_SCOPE(sub)
+#define VITA_PERF_COUNT(cnt)
+
+#endif
+
+#endif /* VITA_PERF_H */
