+	vitaTmLog("TILEMAP_MKXP_STATE %s glState.viewport=%d,%d,%d,%d scissorTest=%d scissorBox=%d,%d,%d,%d blend=%d bound_fbo=%u",
+	          tag, gv.x, gv.y, gv.w, gv.h, (int)glState.scissorTest.get(), gs.x, gs.y, gs.w, gs.h,
+	          (int)glState.blend.get(), (unsigned)FBO::boundFramebufferID.gl);
